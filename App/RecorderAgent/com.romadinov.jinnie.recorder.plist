<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.romadinov.jinnie.recorder</string>
	<key>BundleProgram</key>
	<string>Contents/Library/LoginItems/JinnieRecorder.app/Contents/MacOS/JinnieRecorder</string>
	<key>AssociatedBundleIdentifiers</key>
	<array><string>com.romadinov.jinnie.mac</string></array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Restarted after a crash; "Quit Recorder" (a clean exit) stays quit until the next login or until Jinnie starts it. -->
	<key>KeepAlive</key>
	<dict><key>SuccessfulExit</key><false/></dict>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
